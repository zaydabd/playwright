# Copy to ".env" and fill in. Never commit .env.
BASE_URL=https://avepoint-dev.outsystems.app/BCMS_Web/
TEST_USER=
TEST_PASSWORD=
LOGIN_PATH=Login
# Optional: chromium channel, e.g. msedge (local only)
BROWSER_CHANNEL=
SLOW_SCREEN_MS=1500
MAX_PAGES=80
SCREENSHOTS=flows

# Optional: existing record Ids so the explorer can capture forms in EDIT mode
DIVISION_ID=
DEPARTMENT_ID=
SECTION_ID=
GROUP_ID=
STORE_AREA_TEAM_ID=
COST_CENTER_ID=
INSURER_ID=
CASE_REASON_ID=
TASK_TYPE_ID=
